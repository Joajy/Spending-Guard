{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "spending-guard-prometheus"},
      "fieldConfig": {"defaults": {"mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "up{job=\"spending-guard-backend\"}", "refId": "A"}],
      "title": "Backend up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "spending-guard-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"spending-guard-api\"}[5m])) by (uri)", "legendFormat": "{{uri}}", "refId": "A"}],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "spending-guard-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"spending-guard-api\"}[5m])) by (le))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "spending-guard-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{application=\"spending-guard-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"spending-guard-api\"}[5m])), 0.001)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "Server error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "spending-guard-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "increase(spending_guard_outbox_publish_success_total[5m])", "legendFormat": "published", "refId": "A"},
        {"expr": "increase(spending_guard_outbox_publish_failure_total[5m])", "legendFormat": "failed", "refId": "B"}
      ],
      "title": "Outbox publish results",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "spending-guard-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"expr": "sum(jvm_memory_used_bytes{application=\"spending-guard-api\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{application=\"spending-guard-api\",area=\"heap\"}), 1)", "legendFormat": "heap", "refId": "A"}],
      "title": "JVM heap usage",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["spending-guard", "operations"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
