{
  "info": {
    "name": "Spending Guard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "회원 등록",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('registrationEmail', `User-${pm.variables.replaceIn('{{$guid}}')}@Example.COM`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('정규화된 이메일을 반환한다', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('registrationEmail').toLowerCase()));",
              "pm.test('사용자 Location을 반환한다', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/users/'));",
              "pm.test('비밀번호를 응답하지 않는다', () => pm.expect(pm.response.json()).not.to.have.any.keys('password', 'passwordHash'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"  {{registrationEmail}}  \",\n  \"password\": \"sample-password-123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users"
      }
    },
    {
      "name": "회원 등록 - 이메일 중복",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"another-password-123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('이메일 중복 사유를 반환한다', () => pm.expect(pm.response.json().title).to.eql('Duplicate email'));"
            ]
          }
        }
      ]
    },
    {
      "name": "회원 등록 - 짧은 비밀번호",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-password@example.com\",\n  \"password\": \"short\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('비밀번호 검증 사유를 반환한다', () => pm.expect(pm.response.json().detail).to.match(/^password:/));"
            ]
          }
        }
      ]
    },
    {
      "name": "회원 등록 - 이메일 누락",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"password\": \"sample-password-123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('이메일 검증 사유를 반환한다', () => pm.expect(pm.response.json().detail).to.match(/^email:/));"
            ]
          }
        }
      ]
    },
    {
      "name": "서비스 상태 확인",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('서비스가 UP 상태다', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "소비 알림 접수",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"SIMULATOR\",\n  \"externalEventId\": \"{{$guid}}\",\n  \"message\": \"테스트상점 12,800원 결제\",\n  \"occurredAt\": \"2026-08-13T01:00:00Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/spend-events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('spendEventId', pm.response.json().eventId);",
              "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
              "pm.test('RECEIVED 상태로 접수된다', () => pm.expect(pm.response.json().status).to.eql('RECEIVED'));",
              "pm.test('조회 경로가 Location에 포함된다', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/v1/spend-events/'));"
            ]
          }
        }
      ]
    },
    {
      "name": "소비 이벤트 처리 상태 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/spend-events/{{spendEventId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('접수한 이벤트를 조회한다', () => pm.expect(pm.response.json().eventId).to.eql(pm.collectionVariables.get('spendEventId')));",
              "pm.test('대기 중 상태를 반환한다', () => pm.expect(pm.response.json().status).to.eql('RECEIVED'));",
              "pm.test('분석 전에는 빠른 파싱 결과가 없다', () => pm.expect(pm.response.json().fastParse).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "존재하지 않는 소비 이벤트 조회",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/spend-events/{{$guid}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('조회 실패 사유가 포함된다', () => pm.expect(pm.response.json().title).to.eql('Spend event not found'));"
            ]
          }
        }
      ]
    },
    {
      "name": "중복 확인 - 최초 접수",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('duplicateEventId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('최초 요청은 202 Accepted', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"SIMULATOR\",\n  \"externalEventId\": \"{{duplicateEventId}}\",\n  \"message\": \"테스트택시 18,000원 결제\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/spend-events"
      }
    },
    {
      "name": "중복 확인 - 재접수",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"SIMULATOR\",\n  \"externalEventId\": \"{{duplicateEventId}}\",\n  \"message\": \"테스트택시 18,000원 결제\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/spend-events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('중복 접수 사유가 포함된다', () => pm.expect(pm.response.json().title).to.eql('Duplicate spend event'));"
            ]
          }
        }
      ]
    }
  ]
}
